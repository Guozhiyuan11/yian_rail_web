---
import type { ProjectReference } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  project: ProjectReference;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="flex flex-col border border-steel-200 bg-white">
  {
    project.image && (
      <img
        src={project.image}
        alt={project.imageAlt?.[lang] ?? project.name[lang]}
        class="h-56 w-full border-b border-steel-200 object-cover lg:h-72"
        loading="lazy"
        decoding="async"
      />
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-4">
      <span class="spec-label">{project.country[lang]}</span>
      <span class="text-[13px] font-semibold tabular-nums text-steel-400">{project.year}</span>
    </div>

    <h3 class="mt-3 text-[1.0625rem] font-semibold leading-snug text-ink-900" translate="no">
      {project.name[lang]}
    </h3>

    <div class="mt-4 border-t border-steel-200 pt-4">
      <span class="spec-label block">{t('projectsPage.col.scope')}</span>
      <p class="mt-1.5 text-[14px] font-medium text-ink-800">{project.scope[lang]}</p>
    </div>

    <p class="mt-4 text-[13.5px] leading-relaxed text-steel-600">{project.summary[lang]}</p>

    {
      project.moreUrl && (
        <a href={project.moreUrl} class="link-rule mt-5" target="_blank" rel="noopener noreferrer">
          {t('cta.readReport')}
          <Icon name="arrowRight" size={14} />
        </a>
      )
    }
  </div>
</article>
