---
import Icon from './Icon.astro';

export interface RevealItem {
  title: string;
  text: string;
}

interface Props {
  items: RevealItem[];
  /** Two columns on large screens. */
  columns?: 1 | 2;
  hint?: string;
}

const { items, columns = 2, hint } = Astro.props;
---

<div>
  {
    hint && (
      <p class="mb-4 hidden text-[10px] tracking-[0.16em] text-steel-400 uppercase lg:block">
        {hint}
      </p>
    )
  }

  <ul
    class:list={['border-t border-ink-900', columns === 2 && 'lg:grid lg:grid-cols-2 lg:gap-x-12']}
  >
    {
      items.map((item, i) => (
        <li class="border-b border-steel-200">
          <div class="group reveal-group py-5">
            <div class="flex items-start gap-5">
              <span class="mt-0.5 w-7 shrink-0 text-[11px] tracking-[0.18em] text-steel-400">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="text-[15px] font-semibold text-ink-900">{item.title}</h3>
                  <Icon
                    name="close"
                    size={14}
                    class="hidden shrink-0 rotate-45 text-steel-400 transition-transform duration-300 group-hover:rotate-0 lg:block"
                  />
                </div>

                <div class="reveal">
                  <div class="reveal-inner">
                    <p class="pt-2.5 pr-8 text-[13.5px] leading-relaxed text-steel-600">
                      {item.text}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>
