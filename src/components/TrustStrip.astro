---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface TrustItem {
  icon: IconName;
  title: string;
  description: string;
}

interface Props {
  items: TrustItem[];
}

const { items } = Astro.props;
---

<ul class="grid grid-cols-2 border-l border-t border-steel-200 lg:grid-cols-4">
  {
    items.map((item) => (
      <li class="flex flex-col gap-3 border-b border-r border-steel-200 p-5">
        <span class="inline-flex h-9 w-9 items-center justify-center border border-steel-200 text-ink-700">
          <Icon name={item.icon} size={18} />
        </span>
        <div>
          <h3 class="text-[13.5px] font-semibold leading-snug text-ink-900">{item.title}</h3>
          <p class="mt-1 text-[12.5px] leading-relaxed text-steel-600">{item.description}</p>
        </div>
      </li>
    ))
  }
</ul>
