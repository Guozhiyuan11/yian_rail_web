---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import RFQForm from '../RFQForm.astro';
import Icon from '../Icon.astro';

import { useTranslations, type Lang } from '../../i18n/ui';
import { site, isDev } from '../../utils/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = '/contact';

const whatsappHref = site.contact.whatsappHref;
---

<BaseLayout title={t('contactPage.title')} description={t('contactPage.subtitle')} path={path}>
  <PageHeader
    lang={lang}
    index="06"
    eyebrow={t('contactPage.eyebrow')}
    title={t('contactPage.title')}
    subtitle={t('contactPage.subtitle')}
    breadcrumbs={[{ label: t('common.home'), href: '/' }, { label: t('nav.contact') }]}
  />

  <section class="section">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-12">
        <div>
          <RFQForm
            lang={lang}
            id="contact-rfq"
            title={t('contactPage.form.title')}
            subtitle={t('contactPage.subtitle')}
          />
        </div>

        <aside class="flex flex-col gap-6">
          <div class="border border-steel-200 bg-white p-5">
            <h2 class="text-[15px] font-semibold text-ink-900">{t('contactPage.other.title')}</h2>
            <ul class="mt-5 flex flex-col">
              <li class="flex items-start gap-3.5 border-t border-steel-200 py-4">
                <span
                  class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center border border-steel-200 text-ink-700"
                >
                  <Icon name="mail" size={16} />
                </span>
                <div>
                  <span class="spec-label block">{t('rfq.email')}</span>
                  <a
                    href={`mailto:${site.contact.email}`}
                    class="mt-1 block break-all text-[13px] font-medium text-ink-900"
                  >
                    {site.contact.email}
                  </a>
                </div>
              </li>

              {
                whatsappHref && site.contact.whatsapp ? (
                  <li class="flex items-start gap-3.5 border-t border-steel-200 py-4">
                    <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center border border-steel-200 text-ink-700">
                      <Icon name="whatsapp" size={16} />
                    </span>
                    <div>
                      <span class="spec-label block">{t('cta.whatsapp')}</span>
                      <a
                        href={whatsappHref}
                        class="mt-1 block text-[13px] font-medium text-ink-900"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {site.contact.whatsapp}
                      </a>
                    </div>
                  </li>
                ) : isDev ? (
                  <li class="flex items-start gap-3.5 border-t border-steel-200 py-4 text-steel-400">
                    <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center border border-steel-200">
                      <Icon name="whatsapp" size={16} />
                    </span>
                    <span class="pt-1 text-[10px] uppercase tracking-[0.1em]">
                      {t('common.todo')}
                    </span>
                  </li>
                ) : null
              }

              <li class="flex items-start gap-3.5 border-t border-steel-200 py-4">
                <span
                  class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center border border-steel-200 text-ink-700"
                >
                  <Icon name="pin" size={16} />
                </span>
                <div>
                  <span class="spec-label block">{t('contactPage.location.title')}</span>
                  {
                    site.contact.address ? (
                      <span class="mt-1 block text-[13px] text-ink-900">
                        {site.contact.address}
                      </span>
                    ) : (
                      <span class="mt-1 block text-[10px] uppercase tracking-[0.1em] text-steel-400">
                        {t('common.todo')}
                      </span>
                    )
                  }
                </div>
              </li>
            </ul>
          </div>

          <div class="border border-steel-200 bg-white">
            <div
              class="bg-grid-light flex aspect-[4/3] flex-col items-center justify-center gap-2 text-center"
            >
              <Icon name="pin" size={24} class="text-steel-400" />
              <span class="text-[10px] uppercase tracking-[0.14em] text-steel-400">
                {t('contactPage.mapPlaceholder')}
              </span>
            </div>
            <p
              class="border-t border-steel-200 px-4 py-3 text-center text-[10px] uppercase tracking-[0.1em] text-steel-500"
            >
              {t('contactPage.servingNote')}
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
