---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../Icon.astro';

import { featuredProjects, otherProjects, trackRecord } from '../../data/projects';
import { useTranslations, localizePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = '/projects';
---

<BaseLayout title={t('projectsPage.title')} description={t('projectsPage.subtitle')} path={path}>
  <PageHeader
    lang={lang}
    index="07"
    eyebrow={t('projectsPage.eyebrow')}
    title={t('projectsPage.title')}
    subtitle={t('projectsPage.subtitle')}
    breadcrumbs={[{ label: t('common.home'), href: '/' }, { label: t('nav.projects') }]}
  />

  <!-- Track record figures -->
  <section class="border-b border-steel-200 bg-white">
    <div class="container-x">
      <ul class="grid grid-cols-1 border-l border-t border-steel-200 sm:grid-cols-3">
        {
          trackRecord.map((stat) => (
            <li class="border-b border-r border-steel-200 px-6 py-7">
              <span class="block text-[2rem] font-semibold leading-none tabular-nums text-ink-900 lg:text-[2.5rem]">
                {stat.value}
              </span>
              <span class="mt-3 block text-[12px] uppercase tracking-[0.14em] text-steel-500">
                {t(stat.labelKey)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Attribution — this must stay directly under the figures. -->
  <section class="border-b border-steel-200 bg-steel-50">
    <div class="container-x py-5">
      <p class="flex gap-3 text-[12.5px] leading-relaxed text-steel-600">
        <Icon name="clipboard" size={15} class="mt-1 shrink-0 text-steel-400" />
        {t('projectsPage.attribution')}
      </p>
    </div>
  </section>

  <!-- Flagship lines -->
  <section class="section">
    <div class="container-x">
      <SectionHeading index="01" title={t('projectsPage.featuredTitle')} />
      <ul class="mt-9 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          featuredProjects.map((project) => (
            <li class="flex">
              <ProjectCard project={project} lang={lang} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Further references -->
  <section class="section border-t border-steel-200 bg-steel-50">
    <div class="container-x">
      <SectionHeading index="02" title={t('projectsPage.otherTitle')} />

      <div class="mt-9 overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-left">
          <thead>
            <tr class="border-y border-ink-900">
              <th
                class="py-3 pr-4 text-[10px] font-semibold uppercase tracking-[0.16em] text-steel-500"
              >
                {t('projectsPage.col.project')}
              </th>
              <th
                class="py-3 pr-4 text-[10px] font-semibold uppercase tracking-[0.16em] text-steel-500"
              >
                {t('projectsPage.col.country')}
              </th>
              <th
                class="py-3 pr-4 text-[10px] font-semibold uppercase tracking-[0.16em] text-steel-500"
              >
                {t('projectsPage.col.year')}
              </th>
              <th class="py-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-steel-500">
                {t('projectsPage.col.scope')}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              otherProjects.map((project) => (
                <tr class="border-b border-steel-200 align-top">
                  <td class="py-4 pr-4">
                    {project.moreUrl ? (
                      <a
                        href={project.moreUrl}
                        class="inline-flex items-center gap-1.5 text-[14px] font-medium text-ink-900 underline decoration-steel-300 underline-offset-4 transition-colors hover:decoration-accent-500"
                        target="_blank"
                        rel="noopener noreferrer"
                        translate="no"
                      >
                        {project.name[lang]}
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span class="block text-[14px] font-medium text-ink-900" translate="no">
                        {project.name[lang]}
                      </span>
                    )}
                    <span class="mt-1 block text-[12.5px] text-steel-500">
                      {project.summary[lang]}
                    </span>
                  </td>
                  <td class="py-4 pr-4 text-[13px] text-steel-600">{project.country[lang]}</td>
                  <td class="py-4 pr-4 text-[13px] tabular-nums text-steel-600">{project.year}</td>
                  <td class="py-4 text-[13px] text-ink-800">{project.scope[lang]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink-800 bg-ink-900">
    <div class="container-x py-14 lg:py-16">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:gap-14">
        <div class="lg:border-r lg:border-white/12 lg:pr-14">
          <h2 class="text-white">{t('projectsPage.ctaTitle')}</h2>
          <p class="mt-4 max-w-lg text-[15px] text-steel-300">{t('projectsPage.ctaText')}</p>
        </div>
        <div class="lg:justify-self-end">
          <a href={localizePath('/contact', lang)} class="btn-primary">{t('cta.requestQuote')}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
