---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<li
  class="flex min-h-[4.5rem] items-center justify-center border border-steel-200 bg-white px-4 text-center"
>
  <span class="text-[15px] font-semibold tracking-[0.06em] text-ink-900" translate="no">
    {label}
  </span>
</li>
