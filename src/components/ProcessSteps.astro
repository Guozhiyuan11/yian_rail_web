---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-px border border-steel-200 bg-steel-200 md:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="flex flex-col bg-white p-5">
        <span class="text-[11px] font-semibold tracking-[0.18em] text-steel-400">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-4 text-[14px] font-semibold leading-snug text-ink-900">{step.title}</h3>
        <p class="mt-1.5 text-[12.5px] leading-relaxed text-steel-600">{step.description}</p>
      </li>
    ))
  }
</ol>
