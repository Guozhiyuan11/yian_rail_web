---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
  description?: string;
}

const { icon, title, description } = Astro.props;
---

<li class="flex gap-4 border border-steel-200 bg-white p-4">
  <span
    class="inline-flex h-9 w-9 shrink-0 items-center justify-center border border-steel-200 text-ink-700"
  >
    <Icon name={icon} size={18} />
  </span>
  <div>
    <h3 class="text-[14px] font-semibold text-ink-900">{title}</h3>
    {description && <p class="mt-1 text-[12.5px] leading-relaxed text-steel-600">{description}</p>}
  </div>
</li>
